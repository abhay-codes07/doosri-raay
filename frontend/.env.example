# Copy to .env.local (git-ignored) and fill in from the infra outputs.
VITE_API_URL=https://xxxxxxxxxx.execute-api.ap-south-1.amazonaws.com
VITE_USER_POOL_ID=ap-south-1_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REGION=ap-south-1
# Optional: VAPID public key (base64url). If absent the app calls GET /push/public-key.
VITE_VAPID_PUBLIC_KEY=
# Optional: prefill the parent's e-mail on the /demo left pane. Never put a password here.
VITE_DEMO_PARENT_EMAIL=
# Judge path (/try): a shared judge circle signed in automatically so judges never sign up.
# All four are needed; the values are baked into the JS bundle at build time, so only ever use the
# seeded demo accounts (scripts/seed.py), never a personal account. Leave empty for personal builds.
VITE_JUDGE_EMAIL=
VITE_JUDGE_PASSWORD=
VITE_JUDGE_PARENT_EMAIL=
VITE_JUDGE_PARENT_PASSWORD=
